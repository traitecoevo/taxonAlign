^taxonAlign\.Rproj$
^\.Rproj\.user$
^README\.qmd$
^LICENSE\.md$
# scratch/holding area for retired ported-prototype files -- see CLAUDE.md; not package content
^ignore$
^\.claude$
# scripts that build the data releases (issue #24) -- not package content
^data-raw$
# raw reference exports kept locally for development -- not package content (issue #26)
^inst/extdata$
# not package data: raw AFD exports kept locally for development (issue #26); nothing calls data()
^data$
# the one registered vignette is taxonAlign.Rmd; development-history.qmd is a pkgdown article only,
# rendered with Quarto, and pkgdown skips files starting "_": _demo-align-Prendergast.qmd reads
# ../../austraits.build, so it is rendered locally only
# NB every line here, comments too, is read as a regular expression: keep brackets balanced
^vignettes/development-history\.qmd$
^vignettes/_demo-align-Prendergast\.qmd$
^vignettes/\.gitignore$
^vignettes/\.quarto$
^vignettes/.*_files$
^vignettes/.*\.html$
^vignettes/.*\.knit\.md$
^CLAUDE\.md$
^\.github$
# the pkgdown site
^_pkgdown\.yml$
^docs$
^pkgdown$
^cran-comments\.md$
